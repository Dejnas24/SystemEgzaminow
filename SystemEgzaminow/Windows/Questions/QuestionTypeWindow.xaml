<Window x:Class="SystemEgzaminow.WPF.Windows.Questions.QuestionTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz typ pytania"
        Height="230"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Wybierz typ pytania"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <ComboBox x:Name="QuestionTypeComboBox"
                  Grid.Row="1"
                  Height="35"
                  FontSize="14"
                  SelectedIndex="-1">
        </ComboBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="Zapisz"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="Save_Click" />

            <Button Content="Anuluj"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>