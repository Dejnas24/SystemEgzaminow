<Window x:Class="SystemEgzaminow.WPF.Windows.Tests.StudentTestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemEgzaminow.WPF.Windows.Tests"
        mc:Ignorable="d"
       Title="Wyniki testu"
        Height="680"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0"
                   Text="Wyniki testu"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <!-- Tytuł i typ testu -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">

                <TextBlock Text="Tytuł testu: "
                           FontWeight="Bold" FontSize="14" />

                <TextBlock x:Name="TestTitleTextBlock" FontSize="14" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="Typ testu: "
                           FontWeight="Bold" FontSize="14" />

                <TextBlock x:Name="TestTypeTextBlock" FontSize="14" />
            </StackPanel>
        </StackPanel>

        <!-- Główny panel -->
        <Border Grid.Row="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="8"
                Padding="25">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEWA KOLUMNA -->
                <StackPanel Grid.Column="0">

                    <TextBlock Text="Dane ucznia i wynik"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <TextBlock Text="Uczeń:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="StudentNameTextBlock"
                               Margin="0,2,0,15" />

                    <StackPanel x:Name="PassedResultPanel"
            Margin="0,0,0,15">

                        <TextBlock Text="Czy zaliczony:"
               FontWeight="Bold" />

                        <TextBlock x:Name="PassedTextBlock"
               Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PercentageResultPanel"
            Margin="0,0,0,15">
                        <TextBlock Text="Procent:"
               FontWeight="Bold" />
                        <TextBlock x:Name="PercentageTextBlock"
               Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="PointsResultPanel"
            Margin="0,0,0,15">
                        <TextBlock Text="Punkty zdobyte:"
               FontWeight="Bold" />
                        <TextBlock x:Name="PointsTextBlock"
               Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="GradeResultPanel"
            Margin="0,0,0,15">
                        <TextBlock Text="Ocena:"
               FontWeight="Bold" />
                        <TextBlock x:Name="GradeTextBlock"
               Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Text="Próba:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="AttemptTextBlock" />
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="LightGray"
                        HorizontalAlignment="Center" />

                <!-- PRAWA KOLUMNA -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Dane testu"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <TextBlock Text="Klasa:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="ClassTextBlock"
                               Margin="0,2,0,15" />

                    <TextBlock Text="Rok szkolny:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="SchoolYearTextBlock"
                               Margin="0,2,0,15" />

                    <TextBlock Text="Data i godzina rozwiązania:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="FinishDateTextBlock"
                               Margin="0,2,0,15" />

                    <TextBlock Text="Maksymalna liczba punktów:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="MaxPointsTextBlock"
                               Margin="0,2,0,15" />

                    <TextBlock Text="Minimalny próg procentowy:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="MinimumPercentageTextBlock"
                               Margin="0,2,0,15" />

                    <TextBlock Text="Minimalna liczba punktów:"
                               FontWeight="Bold" />
                    <TextBlock x:Name="MinimumPointsTextBlock" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Przyciski -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="Zamknij"
                    Width="130"
                    Height="40"
                    Margin="10,0"
                    Click="CloseButton_Click" />

            <Button Content="Zapisz do PDF"
                    Width="150"
                    Height="40"
                    Margin="10,0"
                    Click="SavePdfButton_Click" />
        </StackPanel>
    </Grid>
</Window>