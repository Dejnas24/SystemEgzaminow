<UserControl x:Class="SystemEgzaminow.WPF.Views.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0"
                   Text="Panel ucznia"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <!-- Filtry -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">

            <TextBlock Text="Typ testu:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <ComboBox x:Name="TestTypeFilterComboBox"
                      Width="180"
                      Margin="0,0,20,0"
                      SelectionChanged="Filters_SelectionChanged" />

            <TextBlock Text="Status:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <ComboBox x:Name="StatusFilterComboBox"
                      Width="180"
                      Margin="0,0,20,0"
                      SelectionChanged="Filters_SelectionChanged" />

            <TextBlock Text="Rok szkolny:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <ComboBox x:Name="SchoolYearFilterComboBox"
                      Width="180"
                      SelectionChanged="Filters_SelectionChanged" />
        </StackPanel>

        <!-- Wyszukiwanie -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">

            <TextBlock Text="Wyszukaj:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <TextBox x:Name="SearchTextBox"
                     Width="280"
                     Margin="0,0,10,0"
                     TextChanged="SearchTextBox_TextChanged" />

            <Button x:Name="RefreshButton"
                    Content="Odśwież"
                    Width="100"
                    Click="RefreshButton_Click" />
        </StackPanel>

        <!-- Tabela -->
        <DataGrid x:Name="TestyGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,0,0,20">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Nazwa testu"
                                    Binding="{Binding Tytul}"
                                    Width="1.6*" />

                <DataGridTextColumn Header="Typ testu"
                                    Binding="{Binding TypTestu}"
                                    Width="0.8*" />

                <DataGridTextColumn Header="Dostępny od"
                                    Binding="{Binding DataDostepnosci, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="1*" />

                <DataGridTextColumn Header="Dostępny do"
                                    Binding="{Binding DataWygasniecia, StringFormat=dd.MM.yyyy HH:mm}"
                                    Width="1*" />

                <DataGridTextColumn Header="Termin"
                                    Binding="{Binding InformacjaTerminowa}"
                                    Width="1*" />

                <DataGridTextColumn Header="Pozostało prób"
                                    Binding="{Binding PozostaleProby}"
                                    Width="0.7*" />

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding StatusTekst}"
                                    Width="0.8*" />

                <!-- Rozwiąż -->
                <DataGridTemplateColumn Header="Rozwiąż"
                                        Width="0.8*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Rozwiąż"
                                    Width="85"
                                    IsEnabled="{Binding CzyMoznaRozwiazac}"
                                    Click="StartTest_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Wynik -->
                <DataGridTemplateColumn Header="Wynik"
                                        Width="0.7*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Wynik"
                                    Width="75"
                                    IsEnabled="{Binding CzyMoznaPokazacWynik}"
                                    Click="ShowResult_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Przyciski dolne -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Wyloguj"
                    Width="130"
                    Height="40"
                    Margin="10"
                    Click="Logout_Click" />

            <Button Content="Zamknij"
                    Width="130"
                    Height="40"
                    Margin="10"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>