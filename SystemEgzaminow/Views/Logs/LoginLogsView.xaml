<UserControl x:Class="SystemEgzaminow.WPF.Views.Logs.LoginLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views.Logs"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="LoginLogsView_Loaded">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tytuł -->
        <TextBlock Text="Logi logowania"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Grid.Row="0" />

        <!-- Filtry -->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15">

            <!-- Wiersz 1 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="Rola:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />

                <ComboBox x:Name="RoleFilterBox"
                          Width="150"
                          Margin="0,0,15,0"
                          SelectionChanged="RoleFilterBox_SelectionChanged">

                    <ComboBoxItem Content="Wszystkie"
                                  IsSelected="True" />

                    <ComboBoxItem Content="Administrator" />
                    <ComboBoxItem Content="Nauczyciel" />
                    <ComboBoxItem Content="Uczeń" />
                </ComboBox>

                <TextBlock Text="Sesja:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />

                <ComboBox x:Name="SessionFilterBox"
                          Width="150"
                          Margin="0,0,15,0"
                          SelectionChanged="SessionFilterBox_SelectionChanged">

                    <ComboBoxItem Content="Wszystkie"
                                  IsSelected="True" />

                    <ComboBoxItem Content="Zalogowany" />
                    <ComboBoxItem Content="Wylogowany" />
                    <ComboBoxItem Content="Nieudana próba" />
                </ComboBox>

                <TextBlock Text="Data od:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />

                <DatePicker x:Name="DateFromPicker"
                            Width="130"
                            Margin="0,0,15,0"
                            SelectedDateChanged="DateFilter_SelectedDateChanged" />

                <TextBlock Text="Data do:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />

                <DatePicker x:Name="DateToPicker"
                            Width="130"
                            SelectedDateChanged="DateFilter_SelectedDateChanged" />
            </StackPanel>

            <!-- Wiersz 2 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                <TextBlock Text="Wyszukaj:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />

                <TextBox x:Name="SearchBox"
                         Width="300"
                         Height="26"
                         TextChanged="SearchBox_TextChanged" />

                <Button Content="Odśwież"
                        Width="100"
                        Height="30"
                        Margin="10,0,0,0"
                        Click="Refresh_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Tabela -->
        <DataGrid x:Name="LoginLogsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  RowHeight="36"
                  ColumnHeaderHeight="34"
                  GridLinesVisibility="Horizontal"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id}"
                                    Width="0.4*"
                                    MinWidth="55">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Login"
                                    Binding="{Binding Login}"
                                    Width="0.8*"
                                    MinWidth="100" />

                <DataGridTextColumn Header="Użytkownik"
                                    Binding="{Binding ImieNazwisko}"
                                    Width="1.1*"
                                    MinWidth="150" />

                <DataGridTextColumn Header="Rola"
                                    Binding="{Binding Rola}"
                                    Width="0.9*"
                                    MinWidth="120">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Data logowania"
                                    Binding="{Binding DataLogowania,
                                                      StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                    Width="1.1*"
                                    MinWidth="160">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Data wylogowania"
                                    Binding="{Binding DataWylogowania,
                                                      StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                    Width="1.1*"
                                    MinWidth="160">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Sukces"
                                    Binding="{Binding CzySukcesTekst}"
                                    Width="0.6*"
                                    MinWidth="80">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Sesja"
                                    Binding="{Binding SesjaTekst}"
                                    Width="0.9*"
                                    MinWidth="120">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Adres IP"
                                    Binding="{Binding AdresIp}"
                                    Width="0.9*"
                                    MinWidth="120">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Przyciski -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Wróć"
                    Width="160"
                    Height="50"
                    Margin="10"
                    Click="Back_Click" />

            <Button Content="Eksportuj do Excel"
                    Width="180"
                    Height="50"
                    Margin="10"
                    Click="ExportExcel_Click" />
        </StackPanel>
    </Grid>
</UserControl>