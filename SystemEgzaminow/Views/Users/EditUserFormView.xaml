<UserControl x:Class="SystemEgzaminow.WPF.Views.Users.EditUserFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views.Users"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edytuj użytkownika"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <StackPanel Grid.Row="1" Width="300" HorizontalAlignment="Center">

            <TextBlock Text="Login" />
            <TextBox x:Name="LoginBox"
                     Margin="0,0,0,10"
                     IsReadOnly="True" />

            <TextBlock Text="Nowe hasło (pozostaw puste, aby nie zmieniać)" />
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" />

            <TextBlock Text="Imię" />
            <TextBox x:Name="FirstNameBox" Margin="0,0,0,10" />

            <TextBlock Text="Nazwisko" />
            <TextBox x:Name="LastNameBox" Margin="0,0,0,10" />

            <TextBlock Text="Rola" />
            <ComboBox x:Name="RoleBox" Margin="0,0,0,10" SelectionChanged="RoleBox_SelectionChanged">
                <ComboBoxItem Content="Administrator" />
                <ComboBoxItem Content="Nauczyciel" />
                <ComboBoxItem Content="Uczeń" />
            </ComboBox>

            <TextBlock x:Name="SchoolYearLabel"
           Text="Rok szkolny"
           Visibility="Collapsed" />

            <ComboBox x:Name="SchoolYearBox"
          Margin="0,0,0,10"
          Visibility="Collapsed"
          SelectionChanged="SchoolYearBox_SelectionChanged" />

            <TextBlock x:Name="ClassLabel"
           Text="Klasa"
           Visibility="Collapsed" />

            <ComboBox x:Name="ClassBox"
          Margin="0,0,0,10"
          Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,20,0,0">

            <Button Content="Zapisz zmiany"
            Width="160"
            Height="50"
            Margin="10"
            FontSize="14"
            Click="Save_Click" />

            <Button Content="Wróć"
            Width="160"
            Height="50"
            Margin="10"
            FontSize="14"
            Click="Back_Click" />
        </StackPanel>
    </Grid>
</UserControl>