<UserControl x:Class="SystemEgzaminow.WPF.Views.Users.EditUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views.Users"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edycja użytkowników"
  FontSize="26"
  FontWeight="Bold"
  HorizontalAlignment="Center"
  Margin="0,0,0,20"
  Grid.Row="0" />
        <StackPanel Grid.Row="1"
            Orientation="Vertical"
            HorizontalAlignment="Center"
            Margin="0,0,0,15">

            <!-- Wiersz 1 - filtry -->
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                <TextBlock Text="Rola:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />

                <ComboBox x:Name="RoleFilterBox"
                  Width="160"
                  Margin="0,0,15,0"
                  SelectionChanged="RoleFilterBox_SelectionChanged">
                    <ComboBoxItem Content="Wszyscy" IsSelected="True" />
                    <ComboBoxItem Content="Administrator" />
                    <ComboBoxItem Content="Nauczyciel" />
                    <ComboBoxItem Content="Uczeń" />
                </ComboBox>

                <TextBlock Text="Rok szkolny:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />

                <ComboBox x:Name="SchoolYearFilterBox"
                  Width="140"
                  Margin="0,0,15,0"
                  SelectionChanged="SchoolYearFilterBox_SelectionChanged" />

                <TextBlock Text="Klasa:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />

                <ComboBox x:Name="ClassFilterBox"
                  Width="120"
                  Margin="0,0,15,0"
                  SelectionChanged="ClassFilterBox_SelectionChanged" />
            </StackPanel>

            <!-- Wiersz 2 - wyszukiwanie -->
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,0">

                <TextBlock Text="Wyszukaj:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />

                <TextBox x:Name="SearchBox"
                 Width="300"
                 Height="26"
                 TextChanged="SearchBox_TextChanged" />

                <Button Content="Odśwież"
                Width="100"
                 Height="30"
                Margin="10,0,0,0"
                 Click="Refresh_Click" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="UsersGrid"
               Grid.Row="2"
               AutoGenerateColumns="False"
CanUserAddRows="False"
CanUserDeleteRows="False"
CanUserResizeColumns="True"
CanUserSortColumns="True"
IsReadOnly="True"
RowHeaderWidth="0"
RowHeight="36"
ColumnHeaderHeight="34"
GridLinesVisibility="Horizontal"
HorizontalScrollBarVisibility="Auto"
VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Imię"
                        Binding="{Binding Imie}"
                        Width="1.2*"
                        MinWidth="120" />

                <DataGridTextColumn Header="Nazwisko"
                        Binding="{Binding Nazwisko}"
                        Width="1.2*"
                        MinWidth="140" />

                <DataGridTextColumn Header="Rola"
                        Binding="{Binding Rola.Nazwa}"
                        Width="1*"
                        MinWidth="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Klasa"
                        Binding="{Binding Klasa.NazwaKlasy}"
                        Width="0.8*"
                        MinWidth="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Rok szkolny"
                        Binding="{Binding Klasa.RokSzkolny}"
                        Width="1*"
                        MinWidth="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Edytuj"
                            Width="Auto"
                            MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edytuj"
                        MinWidth="82"
                        Height="28"
                        Margin="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CzyMoznaEdytowac}"
                        Click="EditUser_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
   Orientation="Horizontal"
   HorizontalAlignment="Center">
            <Button Content="Wróć"
   Width="130"
   Height="40"
   Margin="10"
   Click="Back_Click" />
        </StackPanel>
    </Grid>
</UserControl>