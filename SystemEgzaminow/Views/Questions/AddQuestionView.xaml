<UserControl x:Class="SystemEgzaminow.WPF.Views.Questions.AddQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views.Questions"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Text="Dodaj pytanie"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"
                   Grid.Row="0" />

        <!-- Pytanie -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Pytanie"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold" />

            <TextBox x:Name="QuestionTextBox"
                     Grid.Column="1"
                     Height="35"
                     FontSize="14"
                     VerticalContentAlignment="Center" />
        </Grid>

        <!-- Punkty + zdjęcie -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Punkty -->
            <TextBlock Text="Punkty"
               VerticalAlignment="Center"
               FontSize="16"
               FontWeight="SemiBold" />

            <TextBox x:Name="PointsTextBox"
             Grid.Column="1"
             Height="35"
             FontSize="14"
             VerticalContentAlignment="Center" />

            <!-- Przycisk dodania -->
            <Button x:Name="AddImageButton"
            Grid.Column="3"
            Content="Dodaj zdjęcie"
            Height="35"
            Padding="10,0"
            Click="AddImage_Click" />

            <!-- RAMKA NA OBRAZ -->
            <Border Grid.Column="5"
            Width="180"
            Height="120"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="5"
            Background="#F5F5F5">

                <Grid>
                    <!-- Obraz -->
                    <Image x:Name="QuestionImage"
       Width="120"
       Height="120"
       Stretch="Uniform" />

                    <TextBlock x:Name="ImageInfoTextBlock"
           Text="Foto dodaj" />
                </Grid>
            </Border>
        </Grid>

        <!-- Typ odpowiedzi -->
        <TextBlock Grid.Row="3"
                   Text="Typ odpowiedzi:"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <Button Content="Zamknięte jednokrotnego wyboru"
                    Height="45"
                    FontSize="15"
                    Margin="150,0,150,10"
                    Click="SingleChoice_Click" />

            <Button Content="Zamknięte wielokrotnego wyboru"
                    Height="45"
                    FontSize="15"
                    Margin="150,0,150,10"
                    Click="MultiChoice_Click" />

            <Button Content="Otwarte"
                    Height="45"
                    FontSize="15"
                    Margin="150,0,150,0"
                    Click="OpenQuestion_Click" />
        </StackPanel>

        <!-- Pusta przestrzeń -->
        <Grid Grid.Row="5" />

        <!-- Przyciski dolne -->
        <Grid Grid.Row="6" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Content="Wróć / anuluj"
                    Grid.Column="1"
                    Width="140"
                    Height="40"
                    Click="Back_Click" />

            <Button Content="Zakończ"
                    Grid.Column="3"
                    Width="140"
                    Height="40"
                    Click="Finish_Click" />
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>