<UserControl x:Class="SystemEgzaminow.WPF.Views.Questions.OpenAnswerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SystemEgzaminow.WPF.Views.Questions"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeaderTextBlock" Text="Dodaj odpowiedź otwartą"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Treść pytania"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />

                    <TextBlock x:Name="QuestionTextBlock"
                               Text="Treść pytania wyświetlona"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Margin="0,0,0,10" />

                    <TextBlock x:Name="PointsTextBlock"
                               Text="Liczba punktów: 0"
                               FontSize="14"
                               Margin="0,0,0,10" />
                </StackPanel>

                <Border Grid.Column="1"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Height="160">
                    <StackPanel>
                        <TextBlock Text="FOTO OPCJONALNE"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <Image x:Name="QuestionImage"
                               Height="100"
                               Stretch="Uniform" />

                        <TextBlock x:Name="NoImageTextBlock"
                                   Text="Brak zdjęcia"
                                   HorizontalAlignment="Center"
                                   Foreground="Gray" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Podaj odpowiedź wzorcową"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <TextBox x:Name="OpenAnswerTextBox"
                         Height="35"
                         Width="400"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Text="Przy sprawdzaniu odpowiedzi system porówna tekst po usunięciu spacji z początku i końca."
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0,10,0,20" />

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                <Button x:Name="SaveButton" Content="Zapisz"
                        Width="140"
                        Height="40"
                        Margin="10"
                        Click="Save_Click" />

                <Button Content="Wróć do pytania"
                        Width="160"
                        Height="40"
                        Margin="10"
                        Click="BackToQuestion_Click" />

                <Button Content="Anuluj"
                        Width="140"
                        Height="40"
                        Margin="10"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>